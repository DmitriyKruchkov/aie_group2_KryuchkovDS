# Environment variables for the spot-price forecasting service.
# Copy this file to .env and fill in values if you override defaults.
# Never commit the real .env to the repository.

# Path to the trained model directory (default: project/artifacts/)
# ARTIFACT_DIR=artifacts

# Path to the feature parquet file used at inference time
# DATA_PATH=data/g5_2xlarge_6h_after_2024-07_with_features.parquet

# Service host and port
# SERVICE_HOST=0.0.0.0
# SERVICE_PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
